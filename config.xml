<?xml version="1.0" encoding="UTF-8"?>
<widget id="io.github.barcelo2023.carteggio" version="1.0.0" xmlns="http://w3.org" xmlns:cdv="http://apache.org">
    <name>Carteggio</name>
    <description>Applicazione per messaggi criptati</description>
    <author email="ibradicich@virgilio.it">Igor</author>
    
    <content src="index.html" />
    <access origin="*" />

    <!-- Configurazione Motore VoltBuilder / Cordova -->
    <preference name="Orientation" value="portrait" />
    <preference name="AndroidXEnabled" value="true" />

    <!-- PLUGIN ADMOB: Sostituisci il valore con il tuo ID APP AdMob reale -->
    <plugin name="cordova-plugin-admob-plus" spec="^1.3.0">
        <variable name="APP_ID_ANDROID" value="ca-app-pub-7064918153021324~1146063265" /> 

    </plugin>

    <!-- Specifiche per la compilazione Android -->
    <platform name="android">
        <preference name="android-minSdkVersion" value="22" />
        <preference name="android-targetSdkVersion" value="34" />
    </platform>
</widget>
